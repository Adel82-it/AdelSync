<Window x:Class="AdelSync.Windows.ToastWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AdelSync"
        Width="360" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" ResizeMode="NoResize" ShowActivated="False">
  <Border Margin="12" CornerRadius="16" Background="#121A2B" BorderBrush="#334155" BorderThickness="1">
    <Border.Effect>
      <DropShadowEffect BlurRadius="24" ShadowDepth="6" Opacity="0.45" Color="Black"/>
    </Border.Effect>
    <Grid Margin="14">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <Border Width="40" Height="40" CornerRadius="10" Background="#0B1220">
        <Image Source="pack://application:,,,/Assets/app.png" Stretch="Uniform" Margin="6"/>
      </Border>
      <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
        <TextBlock x:Name="TitleText" Text="AdelSync" FontWeight="Bold" FontSize="14" Foreground="#E8EEF8"/>
        <TextBlock x:Name="BodyText" Text="" TextWrapping="Wrap" Margin="0,4,0,0"
                   Foreground="#8B9BB8" FontSize="12.5"/>
      </StackPanel>
    </Grid>
  </Border>
</Window>
