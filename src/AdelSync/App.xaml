<Application x:Class="AdelSync.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml"
             ShutdownMode="OnExplicitShutdown">
  <Application.Resources>
    <SolidColorBrush x:Key="BgBrush" Color="#0B1220"/>
    <SolidColorBrush x:Key="CardBrush" Color="#121A2B"/>
    <SolidColorBrush x:Key="CardAltBrush" Color="#172033"/>
    <SolidColorBrush x:Key="TealBrush" Color="#2DD4BF"/>
    <SolidColorBrush x:Key="AmberBrush" Color="#F59E0B"/>
    <SolidColorBrush x:Key="TextBrush" Color="#E8EEF8"/>
    <SolidColorBrush x:Key="MutedBrush" Color="#8B9BB8"/>
    <SolidColorBrush x:Key="DangerBrush" Color="#F87171"/>
    <SolidColorBrush x:Key="OkBrush" Color="#34D399"/>
    <FontFamily x:Key="UiFont">Segoe UI Variable Display, Segoe UI</FontFamily>
  </Application.Resources>
</Application>
